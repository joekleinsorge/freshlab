{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "helpers:pinGitHubActionDigests"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps\\/.*\\.ya?ml$/",
      "/^platform\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "apps/**/values.yaml",
        "platform/**/values.yaml"
      ],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchFileNames": [
        "apps/**",
        "platform/**"
      ]
    },
    {
      "description": "Review system changes independently; allow time for observed recovery",
      "matchFileNames": [
        "system/**"
      ],
      "groupName": null,
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Separate shared platform controllers from ordinary application batches",
      "matchFileNames": [
        "platform/arc/**",
        "platform/runners/**"
      ],
      "groupName": null,
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep internet-facing Plex current independently of unrelated updates",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/plex"
      ],
      "groupName": null,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "dependencyDashboardApproval": false,
      "pinDigests": true,
      "schedule": [
        "at any time"
      ],
      "prPriority": 10,
      "groupSlug": null
    }
  ]
}

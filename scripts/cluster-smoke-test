#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export KUBECONFIG="${KUBECONFIG:-${repo_root}/metal/kubeconfig.yaml}"

required_tools=(curl jq kubectl)
for tool in "${required_tools[@]}"; do
  command -v "${tool}" >/dev/null || {
    echo "Missing required tool: ${tool}" >&2
    exit 1
  }
done

failures=0
echo "Waiting for every node to report Ready..."
kubectl wait --for=condition=Ready nodes --all --timeout=60s || failures=$((failures + 1))

echo "Checking Argo CD application state..."
unhealthy_apps="$(kubectl -n argocd get applications.argoproj.io -o json | jq -r '
  .items[]
  | select(.status.sync.status != "Synced" or .status.health.status != "Healthy")
  | [.metadata.name, .status.sync.status, .status.health.status]
  | @tsv
')"
if [[ -n "${unhealthy_apps}" ]]; then
  echo "Applications that are not Synced and Healthy:" >&2
  printf '%s\n' "${unhealthy_apps}" >&2
  failures=$((failures + 1))
fi

echo "Checking workload availability (including apps behind sign-in pages)..."
unavailable="$(kubectl get deployments,statefulsets,daemonsets -A -o json | jq -r '
  .items[]
  | select(if .kind == "DaemonSet"
      then (.status.numberReady // 0) < (.status.desiredNumberScheduled // 0)
      else (.status.readyReplicas // 0) < (.spec.replicas // 1) end)
  | [.metadata.namespace, .kind, .metadata.name] | @tsv
')"
if [[ -n "${unavailable}" ]]; then
  printf 'Unavailable workloads:\n%s\n' "${unavailable}" >&2
  failures=$((failures + 1))
fi

unbound="$(kubectl get pvc -A -o json | jq -r '
  .items[] | select(.status.phase != "Bound")
  | [.metadata.namespace, .metadata.name, .status.phase] | @tsv
')"
if [[ -n "${unbound}" ]]; then
  printf 'Unbound storage claims:\n%s\n' "${unbound}" >&2
  failures=$((failures + 1))
fi

echo "Checking shared public gateway acceptance and rollout..."
gateway_status="$(kubectl -n istio-system get gateway.gateway.networking.k8s.io freshlab -o json | jq -r '
  [ .status.conditions[]?
    | select(.type == "Accepted" or .type == "Programmed")
    | select(.status == "True")
    | .type
  ] | unique | join(",")
')"
if [[ "${gateway_status}" != *"Accepted"* || "${gateway_status}" != *"Programmed"* ]]; then
  printf 'Shared gateway is not Accepted and Programmed (conditions: %s).\n' "${gateway_status:-none}" >&2
  failures=$((failures + 1))
fi

gateway_ready="$(kubectl -n istio-system get pods \
  -l gateway.networking.k8s.io/gateway-name=freshlab -o json | jq -r '
    [ .items[]
      | select(.status.phase == "Running")
      | select((.status.containerStatuses // []) | length > 0)
      | select(all(.status.containerStatuses[]; .ready == true))
    ] | length
  ')"
if [[ "${gateway_ready}" == "0" ]]; then
  echo "Shared gateway has no Ready generated pod." >&2
  failures=$((failures + 1))
fi

hosts=()
while IFS= read -r host; do
  hosts+=("${host}")
done < <(
  kubectl get httproutes.gateway.networking.k8s.io -A -o json \
    | jq -r '.items[].spec.hostnames[]? | select(contains("*") | not)' \
    | sort -u
)

if ((${#hosts[@]} == 0)); then
  echo "No HTTPRoute hostnames were discovered." >&2
  exit 1
fi

for host in "${hosts[@]}"; do
  path=/
  # This API publishes only /mcp and requires authentication. A 401 proves
  # its protected endpoint is reachable; workload readiness is checked above.
  if [[ "${host}" == argocd-mcp.kleinsorge.dev ]]; then path=/mcp; fi
  # Plex's API root requires a token; its browser application lives at /web/.
  if [[ "${host}" == plex.kleinsorge.dev ]]; then path=/web/; fi
  printf 'Checking https://%s%s ... ' "${host}" "${path}"
  if status="$(curl --location --silent --show-error --output /dev/null \
    --connect-timeout 10 --max-time 45 --retry 2 \
    --write-out '%{http_code}' "https://${host}${path}")" \
    && { [[ "${status}" =~ ^[23][0-9][0-9]$ ]] || { [[ "${path}" == /mcp ]] && [[ "${status}" == 401 ]]; }; }; then
    echo "${status}"
  else
    echo "failed (${status:-no response})"
    failures=$((failures + 1))
  fi
done

if ((failures > 0)); then
  echo "${failures} health check(s) failed." >&2
  exit 1
fi

echo "Cluster and endpoint smoke checks passed."
